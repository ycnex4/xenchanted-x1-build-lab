     let mint = SplTokenMint {
         mint_authority: COption::Some(to_program_pubkey(mint_authority)),
         supply: 0,
         decimals: 18,
         is_initialized: initialized,
         freeze_authority: COption::None,
     };

     SplTokenMint::pack(mint, &mut data).expect("pack SPL mint");
     data
 }

